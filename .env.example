NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Database
DATABASE_URL=postgresql://textile_user:your_db_password@localhost:5432/textile_db
REDIS_URL=redis://localhost:6379
DB_PASSWORD=your_db_password

# Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another_super_secret_refresh_token_key

# AI — OpenRouter (routes to openai/gpt-4o, claude, etc.)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o

# Legacy OpenAI (unused when OpenRouter is configured)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=textile-messages

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Business (Meta Cloud API)
# ─────────────────────────────────────────────────────────────────────────────
# Owner number: +91 8790007228
#
# HOW TO GET THESE:
#   1. Go to https://developers.facebook.com  → Create App → Business
#   2. Add "WhatsApp" product to your app
#   3. In WhatsApp → API Setup you will see:
#      - Phone Number ID    (15-digit number, e.g. 123456789012345)
#      - WhatsApp Business Account ID / WABA ID
#      - Temporary Access Token (valid 24h for testing)
#   4. For permanent token: Business Settings → System Users → Add a system user
#      → Generate Token → select whatsapp_business_messaging & whatsapp_business_management
#   5. App Secret: App → Settings → Basic → App Secret
#   6. Register your webhook:
#      URL   → https://<your-domain>/webhooks/whatsapp
#      Token → value of WHATSAPP_VERIFY_TOKEN below
#      Field → messages
#
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=gspaces-wa-token-changeme
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_WABA_ID=your_waba_id_from_meta
# ─────────────────────────────────────────────────────────────────────────────

# Google / Gmail
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Payment (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxx

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=textile-dashboard-files-dev

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password

# Firebase (push notifications)
FIREBASE_PROJECT_ID=textile-dashboard-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxxxxx\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@textile-dashboard-dev.iam.gserviceaccount.com

# Tally Integration
TALLY_DEFAULT_PORT=9000

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_CASH_FLOW_FORECAST=true
ENABLE_AUTO_LEAD_CREATION=true
