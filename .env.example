NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Database
DATABASE_URL=postgresql://textile_user:your_db_password@localhost:5432/textile_db
REDIS_URL=redis://localhost:6379
DB_PASSWORD=your_db_password

# Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another_super_secret_refresh_token_key

# AI — OpenRouter (routes to openai/gpt-4o, claude, etc.)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o

# Legacy OpenAI (unused when OpenRouter is configured)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=textile-messages

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp & Gmail — CONFIGURED VIA SETTINGS PAGE, NOT HERE
# ─────────────────────────────────────────────────────────────────────────────
# Credentials are stored per-team in the database (IntegrationConfig table).
# Admin/Owner configures them at runtime via: App → Settings → Integrations
#
# These .env vars are ONLY used as a last-resort fallback when no DB record
# exists (e.g. first boot before admin has visited Settings).  Leave them
# blank in production — the Settings page is the source of truth.
#
# HOW TO CONFIGURE:
#   1. Start the app and log in as OWNER or MANAGER
#   2. Go to Settings → Integrations
#   3. Fill in WhatsApp or Gmail credentials and click Save
#   4. Credentials are stored in the DB and scoped to that team only
#   5. Each team/project gets its own credentials — no shared .env keys
#
# ── WhatsApp fallback (overridden by DB once configured in Settings) ──────────
WHATSAPP_API_VERSION=v19.0
WHATSAPP_VERIFY_TOKEN=gspaces-wa-token-changeme
# WHATSAPP_APP_SECRET=         ← set via Settings page
# WHATSAPP_ACCESS_TOKEN=       ← set via Settings page
# WHATSAPP_PHONE_NUMBER_ID=    ← set via Settings page
# WHATSAPP_WABA_ID=            ← set via Settings page
# ─────────────────────────────────────────────────────────────────────────────

# ── Gmail / Google OAuth fallback (overridden by DB once configured in Settings)
# GOOGLE_CLIENT_ID=            ← set via Settings page
# GOOGLE_CLIENT_SECRET=        ← set via Settings page
# GOOGLE_REDIRECT_URI=         ← set via Settings page (default below used if blank)
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/gmail/callback

# Payment (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxx

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=textile-dashboard-files-dev

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password

# Firebase (push notifications)
FIREBASE_PROJECT_ID=textile-dashboard-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxxxxx\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@textile-dashboard-dev.iam.gserviceaccount.com

# Tally Integration
TALLY_DEFAULT_PORT=9000

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_CASH_FLOW_FORECAST=true
ENABLE_AUTO_LEAD_CREATION=true
