// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TENANTS
// ─────────────────────────────────────────────
model Tenant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @db.VarChar(255)
  gstin          String?   @db.VarChar(15)
  address        String?
  city           String?   @default("Surat") @db.VarChar(100)
  state          String?   @default("Gujarat") @db.VarChar(100)
  phone          String?   @db.VarChar(15)
  email          String?   @db.VarChar(255)
  logoUrl        String?
  plan           Plan      @default(STARTER)
  planExpiresAt  DateTime?
  isActive       Boolean   @default(true)
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users                User[]
  groups               Group[]
  parties              Party[]
  products             Product[]
  godowns              Godown[]
  transactions         Transaction[]
  stockMovements       StockMovement[]
  messages             Message[]
  leads                Lead[]
  cashFlowDaily        CashFlowDaily[]
  integrationConfigs   IntegrationConfig[]
  aiChatSessions       AiChatSession[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

enum Plan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users            User[]
  parties          Party[]
  products         Product[]
  godowns          Godown[]
  transactions     Transaction[]
  stockMovements   StockMovement[]
  messages         Message[]
  leads            Lead[]
  cashFlowDaily    CashFlowDaily[]

  @@unique([tenantId, name])
  @@map("groups")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId      String?   @db.Uuid
  group        Group?    @relation(fields: [groupId], references: [id])
  name         String    @db.VarChar(255)
  phone        String?   @unique @db.VarChar(15)
  email        String?   @db.VarChar(255)
  passwordHash String?   @db.VarChar(255)
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  transactions    Transaction[]
  leadsAssigned   Lead[]        @relation("AssignedLeads")
  aiChatSessions  AiChatSession[]
  auditLogs       AuditLog[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  ACCOUNTANT
  STAFF
  READONLY
}

// ─────────────────────────────────────────────
// PARTIES (CUSTOMERS / SUPPLIERS)
// ─────────────────────────────────────────────
model Party {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId        String?   @db.Uuid
  group          Group?    @relation(fields: [groupId], references: [id])
  name           String    @db.VarChar(255)
  type           PartyType @default(CUSTOMER)
  phone          String?   @db.VarChar(15)
  whatsapp       String?   @db.VarChar(15)
  email          String?   @db.VarChar(255)
  address        String?
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  gstin          String?   @db.VarChar(15)
  creditLimit    Decimal   @default(0) @db.Decimal(15, 2)
  currentBalance Decimal   @default(0) @db.Decimal(15, 2)
  tags           String[]
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions   Transaction[]
  messages       Message[]
  leads          Lead[]

  @@index([tenantId])
  @@index([groupId])
  @@map("parties")
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────
model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId       String?  @db.Uuid
  group         Group?   @relation(fields: [groupId], references: [id])
  name          String   @db.VarChar(255)
  code          String?  @db.VarChar(50)
  category      String?  @db.VarChar(100)
  subcategory   String?  @db.VarChar(100)
  unit          Unit     @default(METER)
  hsnCode       String?  @db.VarChar(10)
  gstRate       Decimal  @default(5.00) @db.Decimal(5, 2)
  purchaseRate  Decimal? @db.Decimal(15, 2)
  saleRate      Decimal? @db.Decimal(15, 2)
  currentStock  Decimal  @default(0) @db.Decimal(15, 3)
  reorderLevel  Decimal  @default(0) @db.Decimal(15, 3)
  maxStock      Decimal? @db.Decimal(15, 3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  stockMovements       StockMovement[]
  transactionItems     TransactionItem[]
  stockByGodown        ProductStockByGodown[]

  @@index([tenantId])
  @@index([groupId])
  @@map("products")
}

enum Unit {
  METER
  KG
  PIECE
  BUNDLE
  BOX
  ROLL
}

// ─────────────────────────────────────────────
// GODOWNS
// ─────────────────────────────────────────────
model Godown {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId   String?  @db.Uuid
  group     Group?   @relation(fields: [groupId], references: [id])
  name      String   @db.VarChar(255)
  address   String?
  isActive  Boolean  @default(true)

  stockMovements       StockMovement[]
  transactionItems     TransactionItem[]
  productStockByGodown ProductStockByGodown[]

  @@map("godowns")
}

model ProductStockByGodown {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @db.Uuid
  productId String  @db.Uuid
  godownId  String  @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(15, 3)

  product   Product @relation(fields: [productId], references: [id])
  godown    Godown  @relation(fields: [godownId], references: [id])

  @@unique([productId, godownId])
  @@map("product_stock_by_godown")
}

// ─────────────────────────────────────────────
// TRANSACTIONS (SALES / PURCHASES / PAYMENTS)
// ─────────────────────────────────────────────
model Transaction {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId         String?           @db.Uuid
  group           Group?            @relation(fields: [groupId], references: [id])
  type            TransactionType
  partyId         String?           @db.Uuid
  party           Party?            @relation(fields: [partyId], references: [id])
  referenceNo     String?           @db.VarChar(100)
  date            DateTime          @db.Date
  dueDate         DateTime?         @db.Date
  subtotal        Decimal           @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(15, 2)
  taxableAmount   Decimal           @default(0) @db.Decimal(15, 2)
  cgstAmount      Decimal           @default(0) @db.Decimal(15, 2)
  sgstAmount      Decimal           @default(0) @db.Decimal(15, 2)
  igstAmount      Decimal           @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal           @db.Decimal(15, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(15, 2)
  status          TransactionStatus @default(PENDING)
  paymentMode     String?           @db.VarChar(20)
  notes           String?
  tallyId         String?           @db.VarChar(100)
  createdById     String?           @db.Uuid
  createdBy       User?             @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           TransactionItem[]
  wonLeads        Lead[]

  @@index([tenantId, date])
  @@index([groupId])
  @@index([partyId])
  @@map("transactions")
}

model TransactionItem {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId  String      @db.Uuid
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId      String?     @db.Uuid
  product        Product?    @relation(fields: [productId], references: [id])
  productName    String?     @db.VarChar(255)
  quantity       Decimal     @db.Decimal(15, 3)
  unit           String?     @db.VarChar(20)
  rate           Decimal     @db.Decimal(15, 2)
  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  amount         Decimal     @db.Decimal(15, 2)
  gstRate        Decimal?    @db.Decimal(5, 2)
  gstAmount      Decimal?    @db.Decimal(15, 2)
  totalAmount    Decimal     @db.Decimal(15, 2)
  godownId       String?     @db.Uuid
  godown         Godown?     @relation(fields: [godownId], references: [id])
  batchNo        String?     @db.VarChar(100)
  sortOrder      Int         @default(0)

  @@map("transaction_items")
}

enum TransactionType {
  SALE
  PURCHASE
  RECEIPT
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

// ─────────────────────────────────────────────
// STOCK MOVEMENTS
// ─────────────────────────────────────────────
model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @db.Uuid
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId       String?           @db.Uuid
  group         Group?            @relation(fields: [groupId], references: [id])
  productId     String            @db.Uuid
  product       Product           @relation(fields: [productId], references: [id])
  transactionId String?           @db.Uuid
  godownId      String?           @db.Uuid
  godown        Godown?           @relation(fields: [godownId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(15, 3)
  rate          Decimal?          @db.Decimal(15, 2)
  batchNo       String?           @db.VarChar(100)
  notes         String?
  createdAt     DateTime          @default(now())

  @@index([productId, tenantId])
  @@index([groupId])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE
  SALE
  OPENING
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  SAMPLE
}

// ─────────────────────────────────────────────
// MESSAGES (WHATSAPP + GMAIL UNIFIED INBOX)
// ─────────────────────────────────────────────
model Message {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String?         @db.Uuid
  group       Group?          @relation(fields: [groupId], references: [id])
  partyId     String?         @db.Uuid
  party       Party?          @relation(fields: [partyId], references: [id])
  channel     MessageChannel
  direction   Direction
  fromAddress String?         @db.VarChar(255)
  toAddress   String?         @db.VarChar(255)
  subject     String?         @db.VarChar(500)
  content     String?
  mediaUrls   String[]
  threadId    String?         @db.VarChar(255)
  aiIntent    String?         @db.VarChar(50)
  aiEntities  Json?
  aiSentiment String?         @db.VarChar(20)
  aiLanguage  String?         @db.VarChar(10)
  isRead      Boolean         @default(false)
  isReplied   Boolean         @default(false)
  externalId  String?         @db.VarChar(255)
  createdAt   DateTime        @default(now())

  sourcedLeads Lead[]

  @@index([tenantId, channel, createdAt(sort: Desc)])
  @@index([groupId])
  @@index([partyId])
  @@map("messages")
}

enum MessageChannel {
  WHATSAPP
  GMAIL
  SMS
  MANUAL
}

enum Direction {
  INBOUND
  OUTBOUND
}

// ─────────────────────────────────────────────
// LEADS / CRM
// ─────────────────────────────────────────────
model Lead {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @db.Uuid
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId           String?    @db.Uuid
  group             Group?     @relation(fields: [groupId], references: [id])
  partyId           String?    @db.Uuid
  party             Party?     @relation(fields: [partyId], references: [id])
  sourceMessageId   String?    @db.Uuid
  sourceMessage     Message?   @relation(fields: [sourceMessageId], references: [id])
  title             String?    @db.VarChar(255)
  source            LeadSource?
  status            LeadStatus @default(NEW)
  productInterest   String?
  estimatedQty      Decimal?   @db.Decimal(15, 3)
  estimatedValue    Decimal?   @db.Decimal(15, 2)
  quotedValue       Decimal?   @db.Decimal(15, 2)
  assignedToId      String?    @db.Uuid
  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  followUpDate      DateTime?  @db.Date
  lostReason        String?
  wonTransactionId  String?    @db.Uuid
  wonTransaction    Transaction? @relation(fields: [wonTransactionId], references: [id])
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([tenantId, status])
  @@index([groupId])
  @@map("leads")
}

enum LeadSource {
  WHATSAPP
  GMAIL
  REFERRAL
  WALK_IN
  COLD_CALL
  EXHIBITION
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
  ON_HOLD
}

// ─────────────────────────────────────────────
// CASH FLOW
// ─────────────────────────────────────────────
model CashFlowDaily {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId        String?  @db.Uuid
  group          Group?   @relation(fields: [groupId], references: [id])
  date           DateTime @db.Date
  openingBalance Decimal? @db.Decimal(15, 2)
  cashIn         Decimal  @default(0) @db.Decimal(15, 2)
  cashOut        Decimal  @default(0) @db.Decimal(15, 2)
  closingBalance Decimal? @db.Decimal(15, 2)
  bankBalance    Decimal? @db.Decimal(15, 2)
  notes          String?

  @@unique([tenantId, groupId, date])
  @@map("cash_flow_daily")
}

// ─────────────────────────────────────────────
// INTEGRATION CONFIGS
// ─────────────────────────────────────────────
model IntegrationConfig {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         IntegrationType
  config       Json            @default("{}")
  isActive     Boolean         @default(false)
  lastSyncAt   DateTime?
  syncStatus   String?         @db.VarChar(20)

  @@unique([tenantId, type])
  @@map("integration_configs")
}

enum IntegrationType {
  WHATSAPP
  GMAIL
  TALLY
  MARG
  BUSY
  CUSTOM_ERP
}

// ─────────────────────────────────────────────
// AI CHAT HISTORY
// ─────────────────────────────────────────────
model AiChatSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  messages  AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String        @db.Uuid
  session    AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  sqlQuery   String?
  tokensUsed Int?
  createdAt  DateTime      @default(now())

  @@map("ai_chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(100)
  tableName  String?  @db.VarChar(100)
  recordId   String?  @db.Uuid
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
